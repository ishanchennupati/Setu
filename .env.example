# GREEN-API credentials
# Get these from your instance dashboard at https://console.green-api.com/

# The base API URL for your GREEN-API instance, e.g. https://api.green-api.com
GREEN_API_URL=

# Your GREEN-API Instance ID (a numeric ID shown on the instance dashboard)
GREEN_API_INSTANCE_ID=

# Your GREEN-API API Token (shown on the instance dashboard, keep secret)
GREEN_API_TOKEN=

# Groq API key from https://console.groq.com/keys
GROQ_API_KEY=

# Optional Groq chat model; defaults to openai/gpt-oss-120b
GROQ_MODEL=openai/gpt-oss-120b

# Port the backend listens on (optional, defaults to 3000)
PORT=3000
